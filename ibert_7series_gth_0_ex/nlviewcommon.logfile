#CMD bind stroke-1 -action {}
#CMD bind stroke-nw-1 -action callback -echo_type line -echo_text {Zoom fit} -format (#1C1F28,#FFFFFF,1.0)
module list
#CMD bind stroke-ne-1 -action {}
#CMD bind stroke-se-1 -action zoom_in -echo_type rectangle -autoscroll -echo_text {Zoom area} -format (#1C1F28,#FFFFFF,1.0)
#CMD bind stroke-sw-1 -action zoom_in2 -echo_type line -echo_text {Zoom +%z} -format (#1C1F28,#FFFFFF,1.0)
#CMD bind stroke-nw-1 -action zoom_fit -echo_type line -echo_text {Zoom fit} -format (#1C1F28,#FFFFFF,1.0)
property rubberbandfontsize 13
property rubberbandcolor #1c1f28
module new first -nosplit
#  * Current module is first 
load symbol temporary_object v IGEN pin reset in pinlinewidth 3 pin clk_in1 in pinlinewidth 3 pin clk_out1 out pinlinewidth 3 pin locked out pinlinewidth 3 fillcolor 5 centered
load inst clk_wiz_0 temporary_object v -attr @cell {Clocking Wizard}
attribute {pin clk_wiz_0 reset.reset} -attr @name reset
#ERR attribute: cannot find pin clk_wiz_0 reset.reset
attribute {pin clk_wiz_0 clock_CLK_IN1.clk_in1} -attr @name clk_in1
#ERR attribute: cannot find pin clk_wiz_0 clock_CLK_IN1.clk_in1
attribute {pin clk_wiz_0 clock_CLK_OUT1.clk_out1} -attr @name clk_out1
#ERR attribute: cannot find pin clk_wiz_0 clock_CLK_OUT1.clk_out1
increment -const
show
