# pin_finder_build.tcl
#
# Builds the pin-finder bitstream. Run it from the Vivado Tcl Console
# (no project needs to be open), choosing the channel and refclk first:
#
#   set CH 0; set REF 0; source C:/Users/lskje/Desktop/FPGA_Orderbook/pin_finder/pin_finder_build.tcl
#
#   CH  = channel (0..3) tested in EVERY quad 114..118 at the same time
#   REF = 0 -> each quad's MGTREFCLK0, 1 -> each quad's MGTREFCLK1
#
# Output (next to this script):
#   pin_finder_ch<CH>_ref<REF>.bit   bitstream
#   pin_finder_ch<CH>_ref<REF>.ltx   VIO probes file
#   pins_ch<CH>_ref<REF>.xdc         the pins used for that build
#
# The Vivado project is (re)created in .\prj each time to save disk space.

if {![info exists CH]}  { set CH 0 }
if {![info exists REF]} { set REF 0 }
if {$CH < 0 || $CH > 3}       { error "CH must be 0, 1, 2 or 3" }
if {$REF != 0 && $REF != 1}   { error "REF must be 0 or 1" }

set here [file dirname [file normalize [info script]]]
source [file join $here pins_table.tcl]

set tag     "ch${CH}_ref${REF}"
set prj_dir [file join $here prj]
puts "=== pin_finder: channel $CH in quads 114-118, MGTREFCLK$REF ==="

catch {close_project}
create_project pin_finder $prj_dir -part xc7vx690tffg1157-2 -force
set_property target_language Verilog [current_project]

# ---- 10G PCS/PMA: same settings as OrderBook's ten_gig_eth_pcs_pma_0 ----
if {$REF} { set refsel clk1 } else { set refsel clk0 }
create_ip -name ten_gig_eth_pcs_pma -vendor xilinx.com -library ip -module_name tg_pcs_pma
set_property -dict [list \
  CONFIG.MDIO_Management {true}   \
  CONFIG.base_kr         {BASE-R} \
  CONFIG.SupportLevel    {1}      \
  CONFIG.RefClkRate      {156.25} \
  CONFIG.RefClk          $refsel  \
  CONFIG.DClkRate        {100.00} \
] [get_ips tg_pcs_pma]

# ---- VIO: 5 status inputs, 2 control outputs ----
create_ip -name vio -vendor xilinx.com -library ip -module_name vio_pf
set_property -dict [list \
  CONFIG.C_NUM_PROBE_IN    {5} \
  CONFIG.C_NUM_PROBE_OUT   {2} \
  CONFIG.C_PROBE_IN0_WIDTH {5} \
  CONFIG.C_PROBE_IN1_WIDTH {5} \
  CONFIG.C_PROBE_IN2_WIDTH {5} \
  CONFIG.C_PROBE_IN3_WIDTH {5} \
  CONFIG.C_PROBE_IN4_WIDTH {1} \
] [get_ips vio_pf]

generate_target all [get_ips]

# ---- Pin constraints for this build ----
set xdc [file join $here "pins_${tag}.xdc"]
set f [open $xdc w]
puts $f "## Generated by pin_finder_build.tcl: channel $CH of each quad, MGTREFCLK$REF"
puts $f "## Index q = 0..4 is quad 114..118"
set q 0
foreach Q {114 115 116 117 118} {
  if {$REF} { set rp $REF1P($Q); set rn $REF1N($Q) } else { set rp $REF0P($Q); set rn $REF0N($Q) }
  puts $f ""
  puts $f "## quad $Q"
  puts $f [format {set_property PACKAGE_PIN %-4s [get_ports {refclk_p[%d]}]   ;# MGTREFCLK%dP_%d} $rp $q $REF $Q]
  puts $f [format {set_property PACKAGE_PIN %-4s [get_ports {refclk_n[%d]}]   ;# MGTREFCLK%dN_%d} $rn $q $REF $Q]
  puts $f [format {set_property PACKAGE_PIN %-4s [get_ports {rxp[%d]}]        ;# MGTHRXP%d_%d} [lindex $RXP($Q) $CH] $q $CH $Q]
  puts $f [format {set_property PACKAGE_PIN %-4s [get_ports {rxn[%d]}]        ;# MGTHRXN%d_%d} [lindex $RXN($Q) $CH] $q $CH $Q]
  puts $f [format {set_property PACKAGE_PIN %-4s [get_ports {txp[%d]}]        ;# MGTHTXP%d_%d} [lindex $TXP($Q) $CH] $q $CH $Q]
  puts $f [format {set_property PACKAGE_PIN %-4s [get_ports {txn[%d]}]        ;# MGTHTXN%d_%d} [lindex $TXN($Q) $CH] $q $CH $Q]
  incr q
}
close $f

# ---- Sources ----
add_files -norecurse [file join $here pin_finder_top.v]
add_files -fileset constrs_1 -norecurse [list [file join $here pin_finder.xdc] $xdc]
set_property top pin_finder_top [get_filesets sources_1]
update_compile_order -fileset sources_1

# ---- Build ----
launch_runs impl_1 -to_step write_bitstream -jobs 4
wait_on_run impl_1

set rundir [get_property DIRECTORY [get_runs impl_1]]
set bit    [file join $rundir pin_finder_top.bit]
if {![file exists $bit]} {
  error "Build failed - open [file join $rundir runme.log] (or the synth_1 log) and check the first ERROR."
}
file copy -force $bit [file join $here "pin_finder_${tag}.bit"]
set ltx [file join $rundir pin_finder_top.ltx]
if {[file exists $ltx]} { file copy -force $ltx [file join $here "pin_finder_${tag}.ltx"] }

puts "=== Done ==="
puts "Bitstream: [file join $here pin_finder_${tag}.bit]"
puts "Probes:    [file join $here pin_finder_${tag}.ltx]"
