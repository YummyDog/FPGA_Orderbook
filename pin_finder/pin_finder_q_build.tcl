# pin_finder_q_build.tcl - one channel, borrowed reference clock.
#
# Tests channel CH of quad QUAD, clocked from MGTREFCLK<REF> of quad REFQ
# (default: MGTREFCLK1 of quad 116 = V6/V5, the only refclk that locked).
# The refclk quad must be QUAD itself or directly next to it.
#
# Run from the Vivado Tcl Console (no project open), for example:
#   set QUAD 115; set CH 0; source C:/Users/lskje/Desktop/FPGA_Orderbook/pin_finder/pin_finder_q_build.tcl
#
# Output next to this script:
#   pin_finder_q<QUAD>_ch<CH>.bit / .ltx   and   pins_q<QUAD>_ch<CH>.xdc
#
# Uses pin_finder1_top.v (single core) and pin_finder.xdc (clock/fan).
# The project is (re)created in .\prj_q each time.

if {![info exists QUAD]} { error "set QUAD first (114..118), e.g.  set QUAD 115" }
if {![info exists CH]}   { set CH 0 }
if {![info exists REFQ]} { set REFQ 116 }
if {![info exists REF]}  { set REF 1 }
if {$QUAD < 114 || $QUAD > 118}           { error "QUAD must be 114..118" }
if {$CH < 0 || $CH > 3}                   { error "CH must be 0..3" }
if {abs($QUAD - $REFQ) > 1}               { error "REFQ must be QUAD or a neighbouring quad" }
if {$REF != 0 && $REF != 1}               { error "REF must be 0 or 1" }

set here [file dirname [file normalize [info script]]]
source [file join $here pins_table.tcl]

set tag     "q${QUAD}_ch${CH}"
set prj_dir [file join $here prj_q]
puts "=== pin_finder: quad $QUAD channel $CH, refclk MGTREFCLK${REF}_${REFQ} ==="

catch {close_project}
create_project pin_finder_q $prj_dir -part xc7vx690tffg1157-2 -force
set_property target_language Verilog [current_project]

if {$REF} { set refsel clk1 } else { set refsel clk0 }
create_ip -name ten_gig_eth_pcs_pma -vendor xilinx.com -library ip -module_name tg_pcs_pma
set_property -dict [list \
  CONFIG.MDIO_Management {true}   \
  CONFIG.base_kr         {BASE-R} \
  CONFIG.SupportLevel    {1}      \
  CONFIG.RefClkRate      {156.25} \
  CONFIG.RefClk          $refsel  \
  CONFIG.DClkRate        {100.00} \
] [get_ips tg_pcs_pma]

create_ip -name vio -vendor xilinx.com -library ip -module_name vio_pf
set_property -dict [list \
  CONFIG.C_NUM_PROBE_IN    {5} \
  CONFIG.C_NUM_PROBE_OUT   {2} \
  CONFIG.C_PROBE_IN0_WIDTH {5} \
  CONFIG.C_PROBE_IN1_WIDTH {5} \
  CONFIG.C_PROBE_IN2_WIDTH {5} \
  CONFIG.C_PROBE_IN3_WIDTH {5} \
  CONFIG.C_PROBE_IN4_WIDTH {1} \
] [get_ips vio_pf]

generate_target all [get_ips]

# ---- pins ----
if {$REF} { set rp $REF1P($REFQ); set rn $REF1N($REFQ) } else { set rp $REF0P($REFQ); set rn $REF0N($REFQ) }
set xdc [file join $here "pins_${tag}.xdc"]
set f [open $xdc w]
puts $f "## Generated by pin_finder_q_build.tcl: quad $QUAD channel $CH, refclk MGTREFCLK${REF}_${REFQ}"
puts $f [format {set_property PACKAGE_PIN %-4s [get_ports refclk_p]   ;# MGTREFCLK%dP_%d} $rp $REF $REFQ]
puts $f [format {set_property PACKAGE_PIN %-4s [get_ports refclk_n]   ;# MGTREFCLK%dN_%d} $rn $REF $REFQ]
puts $f [format {set_property PACKAGE_PIN %-4s [get_ports rxp]        ;# MGTHRXP%d_%d} [lindex $RXP($QUAD) $CH] $CH $QUAD]
puts $f [format {set_property PACKAGE_PIN %-4s [get_ports rxn]        ;# MGTHRXN%d_%d} [lindex $RXN($QUAD) $CH] $CH $QUAD]
puts $f [format {set_property PACKAGE_PIN %-4s [get_ports txp]        ;# MGTHTXP%d_%d} [lindex $TXP($QUAD) $CH] $CH $QUAD]
puts $f [format {set_property PACKAGE_PIN %-4s [get_ports txn]        ;# MGTHTXN%d_%d} [lindex $TXN($QUAD) $CH] $CH $QUAD]
close $f

# ---- sources ----
add_files -norecurse [file join $here pin_finder1_top.v]
add_files -fileset constrs_1 -norecurse [list [file join $here pin_finder.xdc] $xdc]
set_property top pin_finder1_top [get_filesets sources_1]
update_compile_order -fileset sources_1

# ---- build ----
launch_runs impl_1 -to_step write_bitstream -jobs 4
wait_on_run impl_1

set rundir [get_property DIRECTORY [get_runs impl_1]]
set bit    [file join $rundir pin_finder1_top.bit]
if {![file exists $bit]} {
  error "Build failed - open [file join $rundir runme.log] (or the synth_1 log) and check the first ERROR."
}
file copy -force $bit [file join $here "pin_finder_${tag}.bit"]
set ltx [file join $rundir pin_finder1_top.ltx]
if {[file exists $ltx]} { file copy -force $ltx [file join $here "pin_finder_${tag}.ltx"] }

puts "=== Done ==="
puts "Bitstream: [file join $here pin_finder_${tag}.bit]"
puts "Probes:    [file join $here pin_finder_${tag}.ltx]"
